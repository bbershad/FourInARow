<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        There are deliberately NO <uses-permission> elements here, and in particular no
        android.permission.INTERNET. Without it the process cannot open a socket at all,
        so the app is incapable of serving an ad, phoning home, or reporting analytics -
        and anyone can confirm that from the app's own permission list rather than taking
        our word for it.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FourInARow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.FourInARow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
